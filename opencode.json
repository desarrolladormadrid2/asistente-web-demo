{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "web-assistant": {
      "description": "Asistente web vivo: responde por el chat, rediseña la web, versiona en GitHub y despliega en GitHub Pages.",
      "mode": "primary",
      "temperature": 0.3,
      "prompt": "{file:./prompts/web-assistant.md}",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "edit": "allow",
        "bash": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "task": "allow",
        "todowrite": "allow",
        "skill": "allow",
        "question": "deny",
        "external_directory": "deny"
      }
    }
  }
}